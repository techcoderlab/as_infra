###############################################################################
# as_infra — Environment Configuration
# Path: /opt/docker-data/source-code/as_infra/infra/.env
#
# Copy this to `.env` in the SAME directory as docker-compose.yml (infra/).
# Never commit the real `.env`. The GitHub Actions deploy job writes its own
# copy on the OptiPlex from repository secrets at deploy time — see
# docs/Deployment-Operations-Checklist.md.
###############################################################################

COMPOSE_PROJECT_NAME=as_infra

# ---- Domain / gateway ----
# Consumed by gateway/nginx.conf.template via envsubst at container start.
DOMAIN=app.yourdomain.tld

# Host-published port — the ONLY port that leaves the container network.
# NPM (on Haier) forwards here.
GATEWAY_PORT=8080

# ---- Image source (filled in automatically by CI) ----
GHCR_NAMESPACE=ghcr.io/techcoderlab/as_infra
IMAGE_TAG=latest

# ---- Laravel (business-agency-saas-api) ----
AS_APP_KEY=                          # php artisan key:generate --show
AS_APP_URL=https://app.yourdomain.tld
AS_FRONTEND_URL=https://app.yourdomain.tld
AS_SCRIBE_AUTH_KEY=change_me_scribe_key
TRUSTED_PROXIES=*                    # both hops in front of Laravel (NPM, gateway) are your own infra

# ---- PostgreSQL ----
POSTGRES_AS_DB=as_infra
POSTGRES_AS_USER=as_infra
POSTGRES_AS_USER_PASSWORD=change_me_postgres_password

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password

# ---- Queue workers ----
QUEUE_CONNECTION=redis

# ---- business-tools-service (Python / FastAPI sidecar) ----
TOOLS_PORT=8017
LARAVEL_APP_ID=change_me_app_id                    # shared identifier the sidecar uses to authenticate callbacks to Laravel
LARAVEL_APP_SECRET=change_me_app_secret            # shared secret — generate with: openssl rand -hex 32
ALLOWED_CALLBACK_DOMAINS=app.yourdomain.tld
MCP_SIDECAR_SERVICE_URL=http://business-tools-service:8017

# ---- PHP-FPM / Opcache tuning — baseline for ~50 active tenants ----
# See docs/Deployment-Operations-Checklist.md "Sizing Math" — these numbers
# are deliberately consistent with business-agency-saas-api's container
# memory limit (see docker-compose.yml). Do not raise PHP_FPM_MAX_CHILDREN
# without raising that memory limit in lockstep — see the checklist for why.
PHP_FPM_MAX_CHILDREN=14
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE_SERVERS=2
PHP_FPM_MAX_SPARE_SERVERS=6
PHP_FPM_MAX_REQUESTS=1000
PHP_MEMORY_LIMIT=256M
OPCACHE_MEMORY_MB=192
