; ##############################################################################
; www.conf.template — PHP-FPM pool, rendered to
; /usr/local/etc/php-fpm.d/www.conf by entrypoint.sh at container start.
;
; Sizing math (full derivation in
; docs/Deployment-Operations-Checklist.md "Sizing Math"): the
; business-agency-saas-api container has a 1024M hard memory ceiling. A
; warm Laravel-API worker typically sits around 50-70MB RSS. At
; PHP_FPM_MAX_CHILDREN=14, worst case is roughly 14 x 70MB ~= 980MB, which
; is uncomfortably close to the ceiling — deliberately, so you notice
; pressure via OOM rather than it silently degrading. If you raise
; PHP_FPM_MAX_CHILDREN, raise the container's `deploy.resources.limits.memory`
; in infra/docker-compose.yml in lockstep, or PHP-FPM will simply never be
; able to spawn that many children before Docker kills the container —
; that mismatch is the actual bug in the pm.max_children=60 /
; memory: 1G combination from the reference guide this was built from.
; ##############################################################################

[www]
user = www-data
group = www-data

listen = 9000
listen.owner = www-data
listen.group = www-data

pm = dynamic
pm.max_children = ${PHP_FPM_MAX_CHILDREN}
pm.start_servers = ${PHP_FPM_START_SERVERS}
pm.min_spare_servers = ${PHP_FPM_MIN_SPARE_SERVERS}
pm.max_spare_servers = ${PHP_FPM_MAX_SPARE_SERVERS}

; Recycle workers periodically to guard against slow memory leaks in
; long-lived tenant-aware singletons — cheap insurance at 50 tenants.
pm.max_requests = ${PHP_FPM_MAX_REQUESTS}

; Not routed publicly by the gateway by default — curl it from inside the
; container, or add a scoped internal route later if you want it in Uptime Kuma.
pm.status_path = /status
ping.path = /ping

; A request stuck this long is almost certainly a tenant-specific bug or an
; upstream (DB/Redis/business-tools-service) hang, not normal load.
request_slowlog_timeout = 10s
slowlog = /var/www/html/storage/logs/php-fpm-slow.log

request_terminate_timeout = 90s

catch_workers_output = yes
decorate_workers_output = no

clear_env = no
