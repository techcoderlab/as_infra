; ##############################################################################
; php.ini.template — rendered to /usr/local/etc/php/conf.d/99-app.ini by
; entrypoint.sh at container start.
; ##############################################################################

memory_limit = ${PHP_MEMORY_LIMIT}
max_execution_time = 60
max_input_time = 60
post_max_size = 25M
upload_max_filesize = 20M
max_file_uploads = 20

; Multi-tenant apps tend to accumulate custom fields / bulk payloads —
; Laravel's default request size assumptions are conservative for this.
max_input_vars = 5000

expose_php = Off
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = /dev/stderr

; Session handling is delegated to Redis (SESSION_DRIVER=redis in Laravel's
; own config) — these are just safe fallback defaults for anything that
; touches native PHP sessions directly.
session.save_handler = files
session.gc_maxlifetime = 7200

date.timezone = "Asia/Karachi"

realpath_cache_size = 4096K
realpath_cache_ttl = 600
