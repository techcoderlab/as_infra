###############################################################################
# gateway/nginx.conf.template — rendered to /etc/nginx/conf.d/app.conf at
# container start (DOMAIN substituted from the environment).
#
# This container never terminates TLS — NPM does that. It trusts and passes
# through the X-Forwarded-* headers NPM already sets (see
# docs/NPM-Reverse-Proxy-Guide.md and TRUSTED_PROXIES in infra/.env).
###############################################################################

upstream laravel_upstream {
    server business-agency-saas-api:9000;
    keepalive 16;
}

upstream tools_upstream {
    server business-tools-service:8017;
    keepalive 8;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # ---- Health endpoint (no upstream dependency) --------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Vue 3 SPA -----------------------------------------------------------
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|mjs|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ---- Laravel's own health check — /up ------------------------------------
    # Laravel 11's `health: '/up'` in bootstrap/app.php registers this route
    # OUTSIDE the `api` group, so it is NOT under /api and would otherwise
    # fall through to the SPA's `location /` (returning index.html, not a
    # real health check) without this explicit block.
    location = /up {
        include /etc/nginx/fastcgi-laravel.conf;
    }

    # ---- Laravel SSE chat streaming — /api/ai-chats/*/chat-stream -----------
    # routes/api.php has a signed, streaming chat-stream route served
    # directly by Laravel (not business-tools-service). Buffering has to be
    # off here specifically — disabling it on the *whole* /api/ block below
    # would hurt every ordinary JSON response's latency for no reason, so
    # this narrower regex location (nginx matches regex locations before
    # the general prefix block) carries the SSE settings instead.
    location ~ ^/api/ai-chats/.+/chat-stream$ {
        include /etc/nginx/fastcgi-laravel.conf;
        fastcgi_buffering off;
        fastcgi_read_timeout 300s;
    }

    # ---- business-tools-service (Python/FastAPI) — /tools/ -------------------
    # SSE-friendly: buffering and caching disabled so AI chat responses
    # from the sidecar reach the client token-by-token instead of being
    # buffered whole.
    location /tools/ {
        proxy_pass http://tools_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;

        # Needed if the sidecar also serves a websocket endpoint under /tools/
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ---- business-agency-saas-api (Laravel) — /api/ — everything else -------
    # No shared filesystem with this container: SCRIPT_FILENAME is a fixed
    # string that must match Laravel's front-controller path *inside the
    # api container's own image* (/var/www/html/public/index.php) — it does
    # not need to exist here. Every request under /api/ is dynamic, so file
    # existence checks are skipped entirely.
    location /api/ {
        include /etc/nginx/fastcgi-laravel.conf;
        fastcgi_read_timeout 90s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
}
